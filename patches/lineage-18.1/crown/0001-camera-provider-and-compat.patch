+#define REQUIRE_PROXY(legacy)                                      \
+    void *legacy_proxy = (void *)(legacy);                         \
+    void *current = acquire_proxy(legacy_proxy);                    \
+    if (!current) {                                                \
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, \
+                            "%s missing proxy for legacy object %p", \
+                            __func__, legacy_proxy);                \
+        return -1;                                                 \
+    }
+
+#define RESOLVE_AND_CALL(symbol, type, ...)                            \
+    do {                                                               \
+        type function = (type)resolve_next(symbol);                    \
+        if (!function) {                                               \
+            release_proxy(legacy_proxy);                               \
+            return -1;                                                 \
+        }                                                              \
+        dp_status_t call_result = function(__VA_ARGS__);               \
+        release_proxy(legacy_proxy);                                   \
+        static bool failure_logged;                                    \
+        if (call_result != 0 &&                                        \
+                !__atomic_exchange_n(&failure_logged, true,             \
+                                     __ATOMIC_RELAXED))                 \
+            __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, \
+                                "%s returned %d", __func__,           \
+                                call_result);                           \
+        return call_result;                                            \
+    } while (0)
