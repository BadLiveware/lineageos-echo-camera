+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#define LOG_TAG "android.hardware.camera.provider@2.4-service.crown"
+
+#include <android/hardware/camera/provider/2.4/ICameraProvider.h>
+#include <dlfcn.h>
+#include <hidl/HidlTransportSupport.h>
+#include <log/log.h>
+
+using android::OK;
+using android::sp;
+using android::status_t;
+using android::hardware::camera::provider::V2_4::ICameraProvider;
+using android::hardware::configureRpcThreadpool;
+using android::hardware::joinRpcThreadpool;
+
+using FetchProvider = ICameraProvider* (*)(const char* name);
+
+int main() {
+    ALOGI("Crown legacy camera provider is starting");
+    configureRpcThreadpool(6, true);
+
+    void* implementation = dlopen(
+            "/vendor/lib/hw/android.hardware.camera.provider@2.4-impl-legacy.so",
+            RTLD_NOW | RTLD_LOCAL);
+    if (implementation == nullptr) {
+        ALOGE("Unable to load the Lineage legacy camera provider: %s", dlerror());
+        return 1;
+    }
+
+    FetchProvider fetchProvider = reinterpret_cast<FetchProvider>(
+            dlsym(implementation, "HIDL_FETCH_ICameraProvider"));
+    if (fetchProvider == nullptr) {
+        ALOGE("Unable to resolve the Lineage legacy camera provider: %s", dlerror());
+        return 1;
+    }
+
+    sp<ICameraProvider> provider = fetchProvider("legacy/0");
+    if (provider == nullptr) {
+        ALOGE("Unable to create the Lineage legacy camera provider");
+        return 1;
+    }
+
+    status_t status = provider->registerAsService("legacy/0");
+    if (status != OK) {
+        ALOGE("Unable to register legacy/0: %d", status);
+        return 1;
+    }
+
+    joinRpcThreadpool();
+    ALOGE("Camera provider RPC threadpool exited unexpectedly");
+    return 1;
+}
