diff --git c/camera/compat/camera_mount_compat.c i/camera/compat/camera_mount_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..7e25289f90c43eb73eb69b1aa03c06e6b446afe5
--- /dev/null
+++ i/camera/compat/camera_mount_compat.c
@@ -0,0 +1,99 @@
+#include <android/log.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#define LOG_TAG "CrownCameraMount"
+#define CROWN_CAMERA_ORIENTATION 0
+#define CROWN_CAPTURE_ROTATION 180
+
+/* camera_info begins with facing and orientation on every camera module API
+ * version used by the legacy adapter. Keeping only the stable prefix avoids a
+ * dependency on framework-private camera headers in this vendor interposer. */
+struct camera_info_prefix {
+    int facing;
+    int orientation;
+};
+
+typedef int (*get_camera_info_fn)(void *, int, void *);
+
+static pthread_once_t g_camera_module_once = PTHREAD_ONCE_INIT;
+static get_camera_info_fn g_get_camera_info;
+
+static void resolve_camera_module(void)
+{
+    const char *symbol =
+        "_ZN7android8hardware6camera6common4V1_06helper12CameraModule13getCameraInfoEiP11camera_info";
+    void *implementation = dlopen(
+        "/vendor/lib/hw/android.hardware.camera.provider@2.4-impl-legacy.so",
+        RTLD_NOW | RTLD_LOCAL);
+    if (implementation)
+        g_get_camera_info = (get_camera_info_fn)dlsym(implementation, symbol);
+    if (!g_get_camera_info) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to resolve CameraModule::getCameraInfo: %s",
+                            dlerror());
+    }
+}
+
+__attribute__((visibility("default")))
+int camera_module_get_info(void *module, int camera_id, void *opaque_info)
+    __asm__("_ZN7android8hardware6camera6common4V1_06helper12CameraModule13getCameraInfoEiP11camera_info");
+
+int camera_module_get_info(void *module, int camera_id, void *opaque_info)
+{
+    pthread_once(&g_camera_module_once, resolve_camera_module);
+    if (!g_get_camera_info)
+        return -1;
+
+    int result = g_get_camera_info(module, camera_id, opaque_info);
+    if (result == 0 && opaque_info) {
+        struct camera_info_prefix *info = opaque_info;
+        int previous = info->orientation;
+        info->orientation = CROWN_CAMERA_ORIENTATION;
+
+        static bool override_logged;
+        if (!__atomic_exchange_n(&override_logged, true, __ATOMIC_RELAXED)) {
+            __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                                "camera orientation %d -> %d", previous,
+                                CROWN_CAMERA_ORIENTATION);
+        }
+    }
+    return result;
+}
+
+typedef int (*camshot_rotation_fn)(void *, uint32_t);
+
+static pthread_once_t g_camshot_once = PTHREAD_ONCE_INIT;
+static camshot_rotation_fn g_camshot_set_rotation;
+
+static void resolve_camshot(void)
+{
+    void *camshot = dlopen("libcam.camshot.so", RTLD_NOW | RTLD_LOCAL);
+    if (!camshot) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to open libcam.camshot.so: %s", dlerror());
+        return;
+    }
+
+    g_camshot_set_rotation = (camshot_rotation_fn)dlsym(
+        camshot, "_ZN9NSCamShot7SImager11setRotationEj");
+    if (!g_camshot_set_rotation) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to resolve capture rotation: %s", dlerror());
+    }
+}
+
+__attribute__((visibility("default")))
+int camshot_set_rotation(void *imager, uint32_t rotation)
+    __asm__("_ZN9NSCamShot7SImager11setRotationEj");
+
+int camshot_set_rotation(void *imager, uint32_t rotation)
+{
+    (void)rotation;
+    pthread_once(&g_camshot_once, resolve_camshot);
+    return g_camshot_set_rotation
+        ? g_camshot_set_rotation(imager, CROWN_CAPTURE_ROTATION)
+        : 0;
+}
diff --git c/camera/compat/crown_imgsensor_compat.c i/camera/compat/crown_imgsensor_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..2bc60432069ec59f873736fb278aa027b42ff5f5
--- /dev/null
+++ i/camera/compat/crown_imgsensor_compat.c
@@ -0,0 +1,254 @@
+#include <android/log.h>
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+#define LOG_TAG "CrownImgSensorCompat"
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+
+#define OLD_INFO_SIZE 144U
+#define NEW_INFO_SIZE 216U
+#define OLD_INFO2_SIZE 204U
+#define NEW_INFO2_SIZE 216U
+
+struct compat_getinfo {
+    uint32_t scenario[2];
+    uint32_t info[2];
+    uint32_t config[2];
+};
+
+struct compat_getinfo2 {
+    uint32_t sensor_id;
+    uint32_t info;
+    uint32_t resolution;
+};
+
+struct compat_feature {
+    uint32_t invoke_camera;
+    uint32_t feature_id;
+    uint32_t parameter;
+    uint32_t parameter_length;
+};
+
+struct compat_control {
+    uint32_t invoke_camera;
+    uint32_t scenario;
+    uint32_t image_window;
+    uint32_t sensor_config;
+};
+
+struct old_mclk {
+    uint8_t on;
+    uint8_t padding[3];
+    uint32_t frequency_group;
+};
+
+struct new_mclk {
+    uint8_t on;
+    uint8_t padding[3];
+    uint32_t frequency_group;
+    uint8_t timing_generator;
+    uint8_t trailing_padding[3];
+};
+
+struct field_map {
+    uint16_t old_offset;
+    uint16_t new_offset;
+    uint8_t size;
+};
+
+static const struct field_map info_tail_fields[] = {
+    {96, 136, 2}, {98, 138, 1}, {99, 139, 1}, {100, 140, 1},
+    {101, 141, 1}, {102, 143, 1}, {103, 144, 1}, {104, 150, 1},
+    {105, 151, 1}, {106, 152, 1}, {107, 153, 1}, {108, 156, 4},
+    {112, 160, 1}, {113, 161, 1}, {114, 162, 1}, {116, 164, 2},
+    {120, 168, 4}, {124, 172, 1}, {125, 174, 1}, {126, 180, 1},
+    {128, 184, 4}, {132, 188, 1}, {133, 189, 1}, {134, 190, 1},
+    {135, 191, 1}, {136, 192, 1}, {140, 196, 4},
+};
+
+typedef int (*ioctl_fn)(int, int, ...);
+
+static ioctl_fn next_ioctl;
+
+/* Crown has no usable TSF calibration in the Lineage workspace. The legacy
+ * algorithm dereferences a null RFK table after preview starts. These exported
+ * MediaTek methods are called through the PLT, so returning false keeps static
+ * lens shading while disabling only temporal shading correction. */
+int crown_lsc_get_tsf(void *instance)
+    __asm__("_ZN11NSIspTuning7LscMgr211getTsfOnOffEv");
+int crown_lsc_rto_get_tsf(void *instance)
+    __asm__("_ZN11NSIspTuning10LscMgr2Rto11getTsfOnOffEv");
+
+int crown_lsc_get_tsf(void *instance)
+{
+    (void)instance;
+    return 0;
+}
+
+int crown_lsc_rto_get_tsf(void *instance)
+{
+    (void)instance;
+    return 0;
+}
+
+static uint32_t scenario_to_kernel(uint32_t scenario)
+{
+    if (scenario <= 3)
+        return scenario;
+    if (scenario <= 9)
+        return scenario + 6;
+    if (scenario <= 15)
+        return scenario - 6;
+    return scenario;
+}
+
+static uint32_t feature_to_kernel(uint32_t feature)
+{
+    if (feature <= 3006)
+        return feature;
+    if (feature <= 3061)
+        return feature + 1;
+    if (feature == 3062)
+        return 3127; /* legacy SENSOR_FEATURE_GET_SENSOR_ID */
+    return feature;
+}
+
+static void info_to_legacy(void *legacy, const void *kernel)
+{
+    size_t i;
+
+    memset(legacy, 0, OLD_INFO_SIZE);
+    memcpy(legacy, kernel, 96);
+    for (i = 0; i < ARRAY_SIZE(info_tail_fields); ++i) {
+        const struct field_map *field = &info_tail_fields[i];
+        memcpy((uint8_t *)legacy + field->old_offset,
+               (const uint8_t *)kernel + field->new_offset,
+               field->size);
+    }
+}
+
+static void info2_to_legacy(void *legacy, const void *kernel)
+{
+    memset(legacy, 0, OLD_INFO2_SIZE);
+    memcpy(legacy, kernel, 166);
+    ((uint8_t *)legacy)[166] = ((const uint8_t *)kernel)[167];
+    memcpy((uint8_t *)legacy + 168, (const uint8_t *)kernel + 168,
+           OLD_INFO2_SIZE - 168);
+}
+
+static int handle_getinfo(int fd, int request, struct compat_getinfo *legacy)
+{
+    struct compat_getinfo translated = *legacy;
+    uint8_t info[2][NEW_INFO_SIZE] = {{0}};
+    int ret;
+    size_t i;
+
+    for (i = 0; i < 2; ++i) {
+        translated.scenario[i] = scenario_to_kernel(legacy->scenario[i]);
+        translated.info[i] = (uint32_t)(uintptr_t)info[i];
+    }
+    ret = next_ioctl(fd, request, &translated);
+    if (ret == 0) {
+        for (i = 0; i < 2; ++i) {
+            void *destination = (void *)(uintptr_t)legacy->info[i];
+            if (destination)
+                info_to_legacy(destination, info[i]);
+        }
+    }
+    return ret;
+}
+
+static int handle_getinfo2(int fd, int request,
+                           struct compat_getinfo2 *legacy)
+{
+    struct compat_getinfo2 translated = *legacy;
+    uint8_t info[NEW_INFO2_SIZE] = {0};
+    int ret;
+
+    translated.info = (uint32_t)(uintptr_t)info;
+    ret = next_ioctl(fd, request, &translated);
+    if (ret == 0 && legacy->info)
+        info2_to_legacy((void *)(uintptr_t)legacy->info, info);
+    return ret;
+}
+
+static int handle_feature(int fd, int request, struct compat_feature *feature)
+{
+    uint32_t legacy_id = feature->feature_id;
+    int ret;
+
+    if (legacy_id == 3112) { /* legacy SENSOR_FEATURE_GET_MUTE_STATE */
+        if (feature->parameter)
+            *(uint32_t *)(uintptr_t)feature->parameter = 0;
+        return 0;
+    }
+
+    feature->feature_id = feature_to_kernel(legacy_id);
+    ret = next_ioctl(fd, request, feature);
+    feature->feature_id = legacy_id;
+    return ret;
+}
+
+static int handle_control(int fd, int request, struct compat_control *control)
+{
+    uint32_t legacy_scenario = control->scenario;
+    int ret;
+
+    control->scenario = scenario_to_kernel(legacy_scenario);
+    ret = next_ioctl(fd, request, control);
+    control->scenario = legacy_scenario;
+    return ret;
+}
+
+static int handle_mclk(int fd, struct old_mclk *legacy)
+{
+    struct new_mclk translated = {
+        .on = legacy->on,
+        .frequency_group = legacy->frequency_group,
+        .timing_generator = 0,
+    };
+    int request = _IOWR('i', 60, struct new_mclk);
+
+    return next_ioctl(fd, request, &translated);
+}
+
+int ioctl(int fd, int request, ...)
+{
+    va_list arguments;
+    void *argument;
+    unsigned int type = _IOC_TYPE(request);
+    unsigned int number = _IOC_NR(request);
+    unsigned int size = _IOC_SIZE(request);
+
+    if (!next_ioctl)
+        next_ioctl = (ioctl_fn)dlsym(RTLD_NEXT, "ioctl");
+
+    /* These imgsensor _IO commands have no third argument. Reading one from
+     * the variadic list is undefined even though the kernel ignores it. */
+    if (type == 'i' && size == 0 &&
+        (number == 0 || number == 25 || number == 30 || number == 50))
+        return next_ioctl(fd, request);
+
+    va_start(arguments, request);
+    argument = va_arg(arguments, void *);
+    va_end(arguments);
+
+    if (type != 'i' || !argument)
+        return next_ioctl(fd, request, argument);
+
+    if (number == 5 && size == sizeof(struct compat_getinfo))
+        return handle_getinfo(fd, request, argument);
+    if (number == 65 && size == sizeof(struct compat_getinfo2))
+        return handle_getinfo2(fd, request, argument);
+    if (number == 15 && size == sizeof(struct compat_feature))
+        return handle_feature(fd, request, argument);
+    if (number == 20 && size == sizeof(struct compat_control))
+        return handle_control(fd, request, argument);
+    if (number == 60 && size == sizeof(struct old_mclk))
+        return handle_mclk(fd, argument);
+
+    return next_ioctl(fd, request, argument);
+}
diff --git c/camera/compat/dpframework_compat.c i/camera/compat/dpframework_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd47a49e4b99426e52d73fd24df2c44367e75830
--- /dev/null
+++ i/camera/compat/dpframework_compat.c
@@ -0,0 +1,602 @@
+#include <android/log.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/time.h>
+
+/*
+ * Android 7 camera objects embed DpIspStream and DpBlitStream using their old
+ * class sizes, while Android 9's kernel-compatible libdpframework expects much
+ * larger objects. Calling the newer constructor on the old allocation writes
+ * beyond it. Route every Dp method used by the camera blobs to separately
+ * allocated Android 9 objects held in an external registry; the old blobs also
+ * write their own fields, so the association cannot live inside the object.
+ */
+
+#define LOG_TAG "CrownDpCompat"
+#define DP_PROXY_BYTES (64u * 1024u)
+#define DP_SECURE_NONE 0
+
+typedef int32_t dp_status_t;
+
+/* Android 9 repacked DpColorFormat's video/plane/subsampling fields. */
+static int32_t translate_color(int32_t legacy_color) {
+    uint32_t legacy = (uint32_t)legacy_color;
+    uint32_t video = (legacy >> 27) & 0x7u;
+    uint32_t planes = (legacy >> 24) & 0x7u;
+    uint32_t horizontal = (legacy >> 20) & 0x3u;
+    uint32_t vertical = (legacy >> 18) & 0x3u;
+    uint32_t translated = (video << 23) | (planes << 21) |
+                          (horizontal << 19) | ((vertical & 0x1u) << 18) |
+                          (legacy & 0x3ffffu);
+
+    uint32_t group = (legacy >> 6) & 0x3u;
+    uint32_t unique = legacy & 0x1fu;
+    if (group == 2u && unique >= 20u && unique <= 22u) {
+        translated = (translated & ~0x1fu) | 20u;
+    } else if (group == 3u) {
+        translated = (translated & ~(0x3u << 6)) | (2u << 6);
+        if (unique >= 20u && unique <= 22u) {
+            translated = (translated & ~0x1fu) | 21u;
+        }
+    }
+    return (int32_t)translated;
+}
+
+typedef struct proxy_entry {
+    void *legacy;
+    void *current;
+    const char *destructor;
+    size_t users;
+    bool destroying;
+    struct proxy_entry *next;
+} proxy_entry_t;
+
+static pthread_mutex_t g_proxy_lock = PTHREAD_MUTEX_INITIALIZER;
+static proxy_entry_t *g_proxies;
+static pthread_once_t g_dpframework_once = PTHREAD_ONCE_INIT;
+static void *g_dpframework;
+
+static void destroy_current(void *object, const char *destructor);
+
+static bool register_proxy(void *legacy, void *current) {
+    proxy_entry_t *entry = calloc(1, sizeof(*entry));
+    if (!entry) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to allocate Dp proxy registry entry");
+        return false;
+    }
+    entry->legacy = legacy;
+    entry->current = current;
+
+    pthread_mutex_lock(&g_proxy_lock);
+    for (proxy_entry_t *existing = g_proxies; existing;
+         existing = existing->next) {
+        if (existing->legacy == legacy) {
+            pthread_mutex_unlock(&g_proxy_lock);
+            free(entry);
+            __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                                "duplicate Dp proxy for legacy object %p",
+                                legacy);
+            return false;
+        }
+    }
+    entry->next = g_proxies;
+    g_proxies = entry;
+    pthread_mutex_unlock(&g_proxy_lock);
+    return true;
+}
+
+static void *acquire_proxy(void *legacy) {
+    void *current = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    for (proxy_entry_t *entry = g_proxies; entry; entry = entry->next) {
+        if (entry->legacy == legacy && !entry->destroying) {
+            ++entry->users;
+            current = entry->current;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    return current;
+}
+
+static void release_proxy(void *legacy) {
+    proxy_entry_t *removed = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    proxy_entry_t **link = &g_proxies;
+    while (*link) {
+        proxy_entry_t *entry = *link;
+        if (entry->legacy == legacy) {
+            if (entry->users > 0) {
+                --entry->users;
+            }
+            if (entry->destroying && entry->users == 0) {
+                *link = entry->next;
+                removed = entry;
+            }
+            break;
+        }
+        link = &entry->next;
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    if (removed) {
+        destroy_current(removed->current, removed->destructor);
+        free(removed);
+    }
+}
+
+static void unregister_proxy(void *legacy, const char *destructor) {
+    proxy_entry_t *removed = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    proxy_entry_t **link = &g_proxies;
+    while (*link) {
+        proxy_entry_t *entry = *link;
+        if (entry->legacy == legacy) {
+            if (!entry->destroying) {
+                entry->destroying = true;
+                entry->destructor = destructor;
+                if (entry->users == 0) {
+                    *link = entry->next;
+                    removed = entry;
+                }
+            }
+            break;
+        }
+        link = &entry->next;
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    if (removed) {
+        destroy_current(removed->current, removed->destructor);
+        free(removed);
+    }
+}
+
+static void open_dpframework(void) {
+    g_dpframework = dlopen("libdpframework.so", RTLD_NOW | RTLD_LOCAL);
+    if (!g_dpframework) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to open libdpframework.so: %s", dlerror());
+    }
+}
+
+static void *resolve_next(const char *symbol) {
+    dlerror();
+    void *function = dlsym(RTLD_NEXT, symbol);
+    if (function) {
+        return function;
+    }
+
+    /*
+     * Android's linker can place an LD_PRELOAD interposer and the vendor
+     * dependency it wraps in different lookup groups. RTLD_NEXT then stops
+     * before libdpframework even though the symbol is exported there. Resolve
+     * against the dependency's own handle to bypass only this interposer.
+     */
+    pthread_once(&g_dpframework_once, open_dpframework);
+    if (g_dpframework) {
+        dlerror();
+        function = dlsym(g_dpframework, symbol);
+        if (function) {
+            return function;
+        }
+    }
+
+    const char *error = dlerror();
+    __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                        "missing wrapped symbol %s: %s", symbol,
+                        error ? error : "unknown dynamic linker error");
+    return NULL;
+}
+
+static void destroy_current(void *object, const char *destructor) {
+    typedef void (*destructor_fn)(void *);
+    destructor_fn function = (destructor_fn)resolve_next(destructor);
+    if (function) {
+        function(object);
+    }
+    free(object);
+}
+
+static void construct_proxy(void *legacy_object, const char *constructor,
+                            int has_argument, int32_t argument) {
+    if (!legacy_object) {
+        return;
+    }
+    void *object = calloc(1, DP_PROXY_BYTES);
+    if (!object) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to allocate Dp proxy object");
+        return;
+    }
+
+    void *function = resolve_next(constructor);
+    if (!function || !register_proxy(legacy_object, object)) {
+        free(object);
+        return;
+    }
+
+    if (has_argument) {
+        typedef void (*constructor_fn)(void *, int32_t);
+        ((constructor_fn)function)(object, argument);
+    } else {
+        typedef void (*constructor_fn)(void *);
+        ((constructor_fn)function)(object);
+    }
+    if (has_argument) {
