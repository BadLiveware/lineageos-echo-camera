diff --git c/camera/compat/camera_awb_compat.c i/camera/compat/camera_awb_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..ded2139efadcbb51cc59d29d0977c7834532c38b
--- /dev/null
+++ i/camera/compat/camera_awb_compat.c
@@ -0,0 +1,363 @@
+#define _GNU_SOURCE
+#include <android/log.h>
+#include <dlfcn.h>
+#include <elf.h>
+#include <errno.h>
+#include <link.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/system_properties.h>
+#include <unistd.h>
+
+#define LOG_TAG "CheckersCameraAwb"
+#define AWB_GAIN_UNITY 512u
+#define AWB_GAIN_MIN 128u
+#define AWB_GAIN_MAX 4096u
+#define AWB_TRIM_MIN 128u
+#define AWB_TRIM_MAX 2048u
+#define AWB_COOL_BLUE_GAIN 640u
+#define AWB_WARM_BLUE_GAIN 835u
+#define AWB_PROPERTY_REFRESH_MASK 15u
+
+struct awb_gain {
+    uint32_t red;
+    uint32_t green;
+    uint32_t blue;
+};
+
+struct awb_trim_config {
+    uint32_t red_cool;
+    uint32_t blue_cool;
+    uint32_t red_warm;
+    uint32_t blue_warm;
+    uint32_t generation;
+    bool trace;
+};
+
+typedef int (*set_awb_gain_fn)(void *, struct awb_gain *);
+typedef int (*legacy_set_awb_gain_fn)(void *, int32_t, struct awb_gain *);
+
+static pthread_once_t g_hook_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t g_awb_lock = PTHREAD_MUTEX_INITIALIZER;
+static set_awb_gain_fn g_set_awb_gain;
+static legacy_set_awb_gain_fn g_legacy_set_awb_gain;
+static struct awb_trim_config g_trim = {
+    .red_cool = AWB_GAIN_UNITY,
+    .blue_cool = AWB_GAIN_UNITY,
+    .red_warm = AWB_GAIN_UNITY,
+    .blue_warm = AWB_GAIN_UNITY,
+    .generation = 1u,
+};
+static uint32_t g_calls;
+static bool g_logged_isp_gain;
+static bool g_logged_legacy_isp_gain;
+
+static int checkers_set_awb_gain(void *manager, struct awb_gain *gain);
+static int checkers_legacy_set_awb_gain(void *manager, int32_t sensor,
+                                        struct awb_gain *gain);
+
+static uint32_t read_trim_property(const char *name) {
+    char value[PROP_VALUE_MAX] = {0};
+    uint32_t parsed = 0u;
+
+    if (__system_property_get(name, value) <= 0) {
+        return AWB_GAIN_UNITY;
+    }
+    for (const char *cursor = value; *cursor; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') {
+            return AWB_GAIN_UNITY;
+        }
+        parsed = parsed * 10u + (uint32_t)(*cursor - '0');
+        if (parsed > AWB_TRIM_MAX) {
+            return AWB_GAIN_UNITY;
+        }
+    }
+    return parsed >= AWB_TRIM_MIN ? parsed : AWB_GAIN_UNITY;
+}
+
+static bool read_bool_property(const char *name) {
+    char value[PROP_VALUE_MAX] = {0};
+    return __system_property_get(name, value) > 0 && value[0] == '1' &&
+           value[1] == '\0';
+}
+
+static void refresh_trim_config(void) {
+    struct awb_trim_config next = {
+        .red_cool = read_trim_property("persist.vendor.camera.awbtrim.r"),
+        .blue_cool = read_trim_property("persist.vendor.camera.awbtrim.b"),
+        .red_warm =
+            read_trim_property("persist.vendor.camera.awbtrim.r.warm"),
+        .blue_warm =
+            read_trim_property("persist.vendor.camera.awbtrim.b.warm"),
+        .generation = g_trim.generation,
+        .trace = read_bool_property("persist.vendor.camera.awbtrim.trace"),
+    };
+
+    bool changed = next.red_cool != g_trim.red_cool ||
+                   next.blue_cool != g_trim.blue_cool ||
+                   next.red_warm != g_trim.red_warm ||
+                   next.blue_warm != g_trim.blue_warm;
+    if (changed) {
+        ++next.generation;
+    }
+    if (changed || next.trace != g_trim.trace) {
+        __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                            "trim cool=%u/%u warm=%u/%u generation=%u trace=%d",
+                            next.red_cool, next.blue_cool, next.red_warm,
+                            next.blue_warm, next.generation, next.trace);
+    }
+    g_trim = next;
+}
+
+static uint32_t interpolate_trim(uint32_t cool, uint32_t warm,
+                                 uint32_t normalized_blue) {
+    uint32_t warm_weight;
+    if (normalized_blue <= AWB_COOL_BLUE_GAIN) {
+        warm_weight = 0u;
+    } else if (normalized_blue >= AWB_WARM_BLUE_GAIN) {
+        warm_weight = 256u;
+    } else {
+        warm_weight = (normalized_blue - AWB_COOL_BLUE_GAIN) * 256u /
+                      (AWB_WARM_BLUE_GAIN - AWB_COOL_BLUE_GAIN);
+    }
+    return (cool * (256u - warm_weight) + warm * warm_weight) >> 8;
+}
+
+static bool trim_gain(const struct awb_gain *raw, struct awb_gain *written,
+                      uint32_t *red_trim, uint32_t *blue_trim) {
+    if (!raw || !written || raw->red < AWB_GAIN_MIN ||
+        raw->red > AWB_GAIN_MAX || raw->green < AWB_GAIN_MIN ||
+        raw->green > AWB_GAIN_MAX || raw->blue < AWB_GAIN_MIN ||
+        raw->blue > AWB_GAIN_MAX) {
+        return false;
+    }
+
+    uint32_t normalized_blue = raw->blue * AWB_GAIN_UNITY / raw->green;
+    *red_trim = interpolate_trim(g_trim.red_cool, g_trim.red_warm,
+                                 normalized_blue);
+    *blue_trim = interpolate_trim(g_trim.blue_cool, g_trim.blue_warm,
+                                  normalized_blue);
+    *written = (struct awb_gain){
+        .red = raw->red * *red_trim / AWB_GAIN_UNITY,
+        .green = raw->green,
+        .blue = raw->blue * *blue_trim / AWB_GAIN_UNITY,
+    };
+    return true;
+}
+
+struct plt_hook_request {
+    const char *library_name;
+    const char *target_symbol;
+    void *replacement;
+    void **original;
+    uint32_t patched;
+};
+
+static uintptr_t loaded_address(uintptr_t base, uintptr_t value) {
+    return value >= base ? value : base + value;
+}
+
+static int patch_plt_callback(struct dl_phdr_info *info, size_t size,
+                              void *opaque) {
+    (void)size;
+    struct plt_hook_request *request = opaque;
+    const char *name = strrchr(info->dlpi_name, '/');
+    name = name ? name + 1 : info->dlpi_name;
+    if (strcmp(name, request->library_name) != 0) {
+        return 0;
+    }
+
+    const ElfW(Dyn) *dynamic = NULL;
+    uintptr_t relro_start = 0u;
+    uintptr_t relro_end = 0u;
+    for (ElfW(Half) index = 0; index < info->dlpi_phnum; ++index) {
+        const ElfW(Phdr) *header = &info->dlpi_phdr[index];
+        if (header->p_type == PT_DYNAMIC) {
+            dynamic = (const ElfW(Dyn) *)(info->dlpi_addr + header->p_vaddr);
+        } else if (header->p_type == PT_GNU_RELRO) {
+            relro_start = info->dlpi_addr + header->p_vaddr;
+            relro_end = relro_start + header->p_memsz;
+        }
+    }
+    if (!dynamic) {
+        return 1;
+    }
+
+    const ElfW(Sym) *symbols = NULL;
+    const char *strings = NULL;
+    const ElfW(Rel) *relocations = NULL;
+    size_t relocation_bytes = 0u;
+    for (const ElfW(Dyn) *entry = dynamic; entry->d_tag != DT_NULL; ++entry) {
+        switch (entry->d_tag) {
+        case DT_SYMTAB:
+            symbols = (const ElfW(Sym) *)loaded_address(
+                info->dlpi_addr, entry->d_un.d_ptr);
+            break;
+        case DT_STRTAB:
+            strings = (const char *)loaded_address(info->dlpi_addr,
+                                                    entry->d_un.d_ptr);
+            break;
+        case DT_JMPREL:
+            relocations = (const ElfW(Rel) *)loaded_address(
+                info->dlpi_addr, entry->d_un.d_ptr);
+            break;
+        case DT_PLTRELSZ:
+            relocation_bytes = entry->d_un.d_val;
+            break;
+        default:
+            break;
+        }
+    }
+    if (!symbols || !strings || !relocations || !relocation_bytes) {
+        return 1;
+    }
+
+    long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        return 1;
+    }
+    size_t count = relocation_bytes / sizeof(*relocations);
+    for (size_t index = 0; index < count; ++index) {
+        uint32_t symbol_index = ELF32_R_SYM(relocations[index].r_info);
+        if (strcmp(strings + symbols[symbol_index].st_name,
+                   request->target_symbol) != 0) {
+            continue;
+        }
+
+        void **slot = (void **)loaded_address(info->dlpi_addr,
+                                               relocations[index].r_offset);
+        if (!*request->original && *slot != request->replacement) {
+            *request->original = *slot;
+        }
+        uintptr_t page = (uintptr_t)slot & ~((uintptr_t)page_size - 1u);
+        bool in_relro = (uintptr_t)slot >= relro_start &&
+                        (uintptr_t)slot < relro_end;
+        if (mprotect((void *)page, (size_t)page_size,
+                     PROT_READ | PROT_WRITE) != 0) {
+            __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                                "unable to unlock PLT slot for %s: %s",
+                                request->target_symbol, strerror(errno));
+            continue;
+        }
+        *slot = request->replacement;
+        ++request->patched;
+        if (in_relro &&
+            mprotect((void *)page, (size_t)page_size, PROT_READ) != 0) {
+            __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                                "unable to relock PLT slot for %s: %s",
+                                request->target_symbol, strerror(errno));
+        }
+    }
+    return 1;
+}
+
+static uint32_t patch_plt(const char *library_name, const char *target_symbol,
+                          void *replacement, void **original) {
+    struct plt_hook_request request = {
+        .library_name = library_name,
+        .target_symbol = target_symbol,
+        .replacement = replacement,
+        .original = original,
+    };
+    dl_iterate_phdr(patch_plt_callback, &request);
+    return request.patched;
+}
+
+static int checkers_set_awb_gain(void *manager, struct awb_gain *gain) {
+    if (!g_set_awb_gain || !gain) {
+        return g_set_awb_gain ? g_set_awb_gain(manager, gain) : -1;
+    }
+
+    struct awb_gain written = *gain;
+    uint32_t red_trim = AWB_GAIN_UNITY;
+    uint32_t blue_trim = AWB_GAIN_UNITY;
+    pthread_mutex_lock(&g_awb_lock);
+    if ((g_calls++ & AWB_PROPERTY_REFRESH_MASK) == 0u) {
+        refresh_trim_config();
+    }
+    bool valid = trim_gain(gain, &written, &red_trim, &blue_trim);
+    bool periodic_trace = g_trim.trace && (g_calls & 63u) == 1u;
+    if (valid && (!g_logged_isp_gain || periodic_trace)) {
+        g_logged_isp_gain = true;
+        __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                            "ISP raw=%u/%u/%u trim=%u/%u output=%u/%u/%u",
+                            gain->red, gain->green, gain->blue, red_trim,
+                            blue_trim, written.red, written.green,
+                            written.blue);
+    }
+    pthread_mutex_unlock(&g_awb_lock);
+
+    return g_set_awb_gain(manager, valid ? &written : gain);
+}
+
+static int checkers_legacy_set_awb_gain(void *manager, int32_t sensor,
+                                        struct awb_gain *gain) {
+    if (!g_legacy_set_awb_gain || !gain) {
+        return g_legacy_set_awb_gain
+            ? g_legacy_set_awb_gain(manager, sensor, gain)
+            : -1;
+    }
+
+    struct awb_gain written = *gain;
+    uint32_t red_trim = AWB_GAIN_UNITY;
+    uint32_t blue_trim = AWB_GAIN_UNITY;
+    pthread_mutex_lock(&g_awb_lock);
+    if ((g_calls++ & AWB_PROPERTY_REFRESH_MASK) == 0u) {
+        refresh_trim_config();
+    }
+    bool valid = trim_gain(gain, &written, &red_trim, &blue_trim);
+    bool periodic_trace = g_trim.trace && (g_calls & 63u) == 1u;
+    if (valid && (!g_logged_legacy_isp_gain || periodic_trace)) {
+        g_logged_legacy_isp_gain = true;
+        __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                            "legacy ISP sensor=%d raw=%u/%u/%u trim=%u/%u output=%u/%u/%u",
+                            sensor, gain->red, gain->green, gain->blue,
+                            red_trim, blue_trim, written.red, written.green,
+                            written.blue);
+    }
+    pthread_mutex_unlock(&g_awb_lock);
+
+    return g_legacy_set_awb_gain(manager, sensor, valid ? &written : gain);
+}
+
+static void install_awb_hooks_once(void) {
+    static const char set_gain_symbol[] =
+        "_ZN13NSIspTuningv312IspTuningMgr10setAWBGainER10AWB_GAIN_T";
+    static const char legacy_set_gain_symbol[] =
+        "_ZN11NSIspTuning12IspTuningMgr10setAWBGainEiR10AWB_GAIN_T";
+
+    void *hal3a = dlopen("libcam.hal3a.v3.so", RTLD_NOW | RTLD_LOCAL);
+    uint32_t isp_hooks = hal3a
+        ? patch_plt("libcam.hal3a.v3.so", set_gain_symbol,
+                    (void *)(uintptr_t)checkers_set_awb_gain,
+                    (void **)&g_set_awb_gain)
+        : 0u;
+
+    void *featureio = dlopen("libfeatureio.so", RTLD_NOW | RTLD_LOCAL);
+    uint32_t legacy_hooks = featureio
+        ? patch_plt("libfeatureio.so", legacy_set_gain_symbol,
+                    (void *)(uintptr_t)checkers_legacy_set_awb_gain,
+                    (void **)&g_legacy_set_awb_gain)
+        : 0u;
+
+    if (isp_hooks || legacy_hooks) {
+        __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                            "installed AWB ISP hooks v3=%u legacy=%u with unity defaults",
+                            isp_hooks, legacy_hooks);
+    } else {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "no supported AWB ISP gain calls found");
+    }
+}
+
+void checkers_install_awb_hook(void) {
+    pthread_once(&g_hook_once, install_awb_hooks_once);
+}
+
+__attribute__((constructor))
+static void initialize_awb_hook(void) {
+    checkers_install_awb_hook();
+}
diff --git c/camera/compat/camera_mount_compat.c i/camera/compat/camera_mount_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..5b7342a05daa816ccdcec558095fe8f0007aaf0d
--- /dev/null
+++ i/camera/compat/camera_mount_compat.c
@@ -0,0 +1,117 @@
+#include <android/log.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#define LOG_TAG "CheckersCameraMount"
+#define CHECKERS_CAMERA_ORIENTATION 0
+#define CHECKERS_CAPTURE_ROTATION 180
+#define CHECKERS_CAPTURE_FLIP 1
+
+/* camera_info begins with facing and orientation on every camera module API
+ * version used by the legacy adapter. Keeping only the stable prefix avoids a
+ * dependency on framework-private camera headers in this vendor interposer. */
+struct camera_info_prefix {
+    int facing;
+    int orientation;
+};
+
+typedef int (*get_camera_info_fn)(void *, int, void *);
+
+static pthread_once_t g_camera_module_once = PTHREAD_ONCE_INIT;
+static get_camera_info_fn g_get_camera_info;
+
+void checkers_install_awb_hook(void);
+
+static void resolve_camera_module(void) {
+    checkers_install_awb_hook();
+    const char *symbol =
+        "_ZN7android8hardware6camera6common4V1_06helper12CameraModule13getCameraInfoEiP11camera_info";
+    void *implementation = dlopen(
+        "/vendor/lib/hw/android.hardware.camera.provider@2.4-impl-legacy.so",
+        RTLD_NOW | RTLD_LOCAL);
+    if (implementation) {
+        g_get_camera_info = (get_camera_info_fn)dlsym(implementation, symbol);
+    }
+    if (!g_get_camera_info) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to resolve CameraModule::getCameraInfo: %s",
+                            dlerror());
+    }
+}
+
+__attribute__((visibility("default")))
+int camera_module_get_info(void *module, int camera_id, void *opaque_info)
+    __asm__("_ZN7android8hardware6camera6common4V1_06helper12CameraModule13getCameraInfoEiP11camera_info");
+
+int camera_module_get_info(void *module, int camera_id, void *opaque_info) {
+    pthread_once(&g_camera_module_once, resolve_camera_module);
+    if (!g_get_camera_info) {
+        return -1;
+    }
+
+    int result = g_get_camera_info(module, camera_id, opaque_info);
+    if (result == 0 && opaque_info) {
+        struct camera_info_prefix *info = opaque_info;
+        int previous = info->orientation;
+        info->orientation = CHECKERS_CAMERA_ORIENTATION;
+
+        static bool override_logged;
+        if (!__atomic_exchange_n(&override_logged, true, __ATOMIC_RELAXED)) {
+            __android_log_print(ANDROID_LOG_INFO, LOG_TAG,
+                                "camera orientation %d -> %d", previous,
+                                CHECKERS_CAMERA_ORIENTATION);
+        }
+    }
+    return result;
+}
+
+typedef int (*camshot_transform_fn)(void *, uint32_t);
+
+static pthread_once_t g_camshot_once = PTHREAD_ONCE_INIT;
+static camshot_transform_fn g_camshot_set_rotation;
+static camshot_transform_fn g_camshot_set_flip;
+
+static void resolve_camshot(void) {
+    void *camshot = dlopen("libcam.camshot.so", RTLD_NOW | RTLD_LOCAL);
+    if (!camshot) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to open libcam.camshot.so: %s", dlerror());
+        return;
+    }
+
+    g_camshot_set_rotation = (camshot_transform_fn)dlsym(
+        camshot, "_ZN9NSCamShot7SImager11setRotationEj");
+    g_camshot_set_flip = (camshot_transform_fn)dlsym(
+        camshot, "_ZN9NSCamShot7SImager7setFlipEj");
+    if (!g_camshot_set_rotation || !g_camshot_set_flip) {
+        __android_log_print(ANDROID_LOG_ERROR, LOG_TAG,
+                            "unable to resolve capture transforms: %s",
+                            dlerror());
+    }
+}
+
+__attribute__((visibility("default")))
+int camshot_set_rotation(void *imager, uint32_t rotation)
+    __asm__("_ZN9NSCamShot7SImager11setRotationEj");
+
+int camshot_set_rotation(void *imager, uint32_t rotation) {
+    (void)rotation;
+    pthread_once(&g_camshot_once, resolve_camshot);
+    return g_camshot_set_rotation
+        ? g_camshot_set_rotation(imager, CHECKERS_CAPTURE_ROTATION)
+        : 0;
+}
+
+__attribute__((visibility("default")))
+int camshot_set_flip(void *imager, uint32_t flip)
+    __asm__("_ZN9NSCamShot7SImager7setFlipEj");
+
+int camshot_set_flip(void *imager, uint32_t flip) {
+    (void)flip;
+    pthread_once(&g_camshot_once, resolve_camshot);
+    return g_camshot_set_flip
+        ? g_camshot_set_flip(imager, CHECKERS_CAPTURE_FLIP)
+        : 0;
+}
diff --git c/camera/compat/dpframework_compat.c i/camera/compat/dpframework_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ca37486bb6771efd39685abd8ccb2988180ccd4
--- /dev/null
+++ i/camera/compat/dpframework_compat.c
@@ -0,0 +1,602 @@
+#include <android/log.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/time.h>
+
+/*
+ * Android 7 camera objects embed DpIspStream and DpBlitStream using their old
+ * class sizes, while Android 9's kernel-compatible libdpframework expects much
+ * larger objects. Calling the newer constructor on the old allocation writes
+ * beyond it. Route every Dp method used by the camera blobs to separately
+ * allocated Android 9 objects held in an external registry; the old blobs also
+ * write their own fields, so the association cannot live inside the object.
+ */
+
+#define DP_PROXY_BYTES (64u * 1024u)
+#define DP_SECURE_NONE 0
+
+typedef int32_t dp_status_t;
+
+/* Android 9 repacked DpColorFormat's video/plane/subsampling fields. */
+static int32_t translate_color(int32_t legacy_color) {
+    uint32_t legacy = (uint32_t)legacy_color;
+    uint32_t video = (legacy >> 27) & 0x7u;
+    uint32_t planes = (legacy >> 24) & 0x7u;
+    uint32_t horizontal = (legacy >> 20) & 0x3u;
+    uint32_t vertical = (legacy >> 18) & 0x3u;
+    uint32_t translated = (video << 23) | (planes << 21) |
+                          (horizontal << 19) | ((vertical & 0x1u) << 18) |
+                          (legacy & 0x3ffffu);
+
+    uint32_t group = (legacy >> 6) & 0x3u;
+    uint32_t unique = legacy & 0x1fu;
+    if (group == 2u && unique >= 20u && unique <= 22u) {
+        translated = (translated & ~0x1fu) | 20u;
+    } else if (group == 3u) {
+        translated = (translated & ~(0x3u << 6)) | (2u << 6);
+        if (unique >= 20u && unique <= 22u) {
+            translated = (translated & ~0x1fu) | 21u;
+        }
+    }
+    return (int32_t)translated;
+}
+
+typedef struct proxy_entry {
+    void *legacy;
+    void *current;
+    const char *destructor;
+    size_t users;
+    bool destroying;
+    struct proxy_entry *next;
+} proxy_entry_t;
+
+static pthread_mutex_t g_proxy_lock = PTHREAD_MUTEX_INITIALIZER;
+static proxy_entry_t *g_proxies;
+static pthread_once_t g_dpframework_once = PTHREAD_ONCE_INIT;
+static void *g_dpframework;
+
+static void destroy_current(void *object, const char *destructor);
+
+static bool register_proxy(void *legacy, void *current) {
+    proxy_entry_t *entry = calloc(1, sizeof(*entry));
+    if (!entry) {
+        __android_log_print(ANDROID_LOG_ERROR, "CheckersDpCompat",
+                            "unable to allocate Dp proxy registry entry");
+        return false;
+    }
+    entry->legacy = legacy;
+    entry->current = current;
+
+    pthread_mutex_lock(&g_proxy_lock);
+    for (proxy_entry_t *existing = g_proxies; existing;
+         existing = existing->next) {
+        if (existing->legacy == legacy) {
+            pthread_mutex_unlock(&g_proxy_lock);
+            free(entry);
+            __android_log_print(ANDROID_LOG_ERROR, "CheckersDpCompat",
+                                "duplicate Dp proxy for legacy object %p",
+                                legacy);
+            return false;
+        }
+    }
+    entry->next = g_proxies;
+    g_proxies = entry;
+    pthread_mutex_unlock(&g_proxy_lock);
+    return true;
+}
+
+static void *acquire_proxy(void *legacy) {
+    void *current = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    for (proxy_entry_t *entry = g_proxies; entry; entry = entry->next) {
+        if (entry->legacy == legacy && !entry->destroying) {
+            ++entry->users;
+            current = entry->current;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    return current;
+}
+
+static void release_proxy(void *legacy) {
+    proxy_entry_t *removed = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    proxy_entry_t **link = &g_proxies;
+    while (*link) {
+        proxy_entry_t *entry = *link;
+        if (entry->legacy == legacy) {
+            if (entry->users > 0) {
+                --entry->users;
+            }
+            if (entry->destroying && entry->users == 0) {
+                *link = entry->next;
+                removed = entry;
+            }
+            break;
+        }
+        link = &entry->next;
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    if (removed) {
+        destroy_current(removed->current, removed->destructor);
+        free(removed);
+    }
+}
+
+static void unregister_proxy(void *legacy, const char *destructor) {
+    proxy_entry_t *removed = NULL;
+    pthread_mutex_lock(&g_proxy_lock);
+    proxy_entry_t **link = &g_proxies;
+    while (*link) {
+        proxy_entry_t *entry = *link;
+        if (entry->legacy == legacy) {
+            if (!entry->destroying) {
+                entry->destroying = true;
+                entry->destructor = destructor;
+                if (entry->users == 0) {
+                    *link = entry->next;
+                    removed = entry;
+                }
+            }
+            break;
+        }
+        link = &entry->next;
+    }
+    pthread_mutex_unlock(&g_proxy_lock);
+    if (removed) {
+        destroy_current(removed->current, removed->destructor);
+        free(removed);
+    }
+}
